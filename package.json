{
  "name": "catalii",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "media:dev": "wrangler dev -c media-worker/wrangler.jsonc --port 8788 --persist-to .wrangler/state",
    "media:deploy": "wrangler deploy -c media-worker/wrangler.jsonc",
    "media:buckets": "wrangler r2 bucket create catalii-products && wrangler r2 bucket create catalii-logos && wrangler r2 bucket create catalii-banners",
    "backend:dev": "pnpm -C backend dev",
    "backend:start": "pnpm -C backend start",
    "backend:typecheck": "pnpm -C backend typecheck"
  },
  "dependencies": {
    "@paddle/paddle-js": "1.4.2",
    "@paddle/paddle-node-sdk": "3.2.0",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.58.0",
    "clsx": "2.1.1",
    "lodash.throttle": "4.1.1",
    "lucide-react": "0.469.0",
    "next": "16.3.1",
    "papaparse": "5.5.3",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "2.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/lodash.throttle": "4.1.9",
    "@types/node": "^20",
    "@types/papaparse": "5.3.15",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.124.0"
  },
  "packageManager": "pnpm@11.3.0"
}
