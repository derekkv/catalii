{
	"name": "catalii",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"NEXT_PUBLIC_SITE_URL": "https://catalii.com",
		"NEXT_PUBLIC_SUPABASE_URL": "REEMPLAZAR_CON_URL_SUPABASE",
		"NEXT_PUBLIC_SUPABASE_ANON_KEY": "REEMPLAZAR_CON_ANON_KEY_SUPABASE",
		"NEXT_PUBLIC_PADDLE_ENV": "sandbox",
		"NEXT_PUBLIC_PADDLE_CLIENT_TOKEN": "REEMPLAZAR",
		"NEXT_PUBLIC_PADDLE_PRICE_STARTER": "pri_REEMPLAZAR",
		"NEXT_PUBLIC_PADDLE_PRICE_PRO": "pri_REEMPLAZAR",
		"NEXT_PUBLIC_PADDLE_PRICE_BUSINESS": "pri_REEMPLAZAR",
		"NEXT_PUBLIC_MEDIA_URL": "",
		"NEXT_PUBLIC_SHOW_DEV_NOTICE": "false"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "catalii-cache"
		},
		{
			"binding": "MEDIA_PRODUCTS",
			"bucket_name": "catalii-products"
		},
		{
			"binding": "MEDIA_LOGOS",
			"bucket_name": "catalii-logos"
		},
		{
			"binding": "MEDIA_BANNERS",
			"bucket_name": "catalii-banners"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "NEXT_CACHE_DO_QUEUE",
				"class_name": "DOQueueHandler"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"DOQueueHandler"
			]
		}
	]
}