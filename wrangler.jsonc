{
	"name": "catalii",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"NEXT_PUBLIC_SITE_URL": "https://catalii.com",
		// FALTA: pon la URL y la clave anon de tu proyecto (Supabase > Project
		// Settings > API). Sin esto la app desplegada no conecta con la base.
		"NEXT_PUBLIC_SUPABASE_URL": "https://ejzvwogkchhaebjhmdzg.supabase.co",
		"NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_3xgdeyrhFfgf_MoCiom0Fg_M2c-AeYK",
		"NEXT_PUBLIC_PADDLE_ENV": "sandbox",
		"NEXT_PUBLIC_PADDLE_CLIENT_TOKEN": "test_ebb1130b591d3bb938200f052ee",
		"NEXT_PUBLIC_PADDLE_PRICE_STARTER": "pri_01m7y5we9fj95dsyj4pvyy97z1",
		"NEXT_PUBLIC_PADDLE_PRICE_PRO": "pri_01m7y5wetzgvtftfan75sw4y6v",
		"NEXT_PUBLIC_PADDLE_PRICE_BUSINESS": "pri_01m7y5wf4j2xj3be9q7v49y0e7",
		"NEXT_PUBLIC_MEDIA_URL": "https://media.catalii.com",
		"NEXT_PUBLIC_SHOW_DEV_NOTICE": "false"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"binding": "MEDIA_PRODUCTS",
			"bucket_name": "catalii-products"
		},
		{
			"binding": "MEDIA_LOGOS",
			"bucket_name": "catalii-logos"
		},
		{
			"binding": "MEDIA_BANNERS",
			"bucket_name": "catalii-banners"
		}
	]
}