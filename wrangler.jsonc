{
	"name": "catalii",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "catalii-cache"
		},
		{
			"binding": "MEDIA_PRODUCTS",
			"bucket_name": "catalii-products"
		},
		{
			"binding": "MEDIA_LOGOS",
			"bucket_name": "catalii-logos"
		},
		{
			"binding": "MEDIA_BANNERS",
			"bucket_name": "catalii-banners"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "NEXT_CACHE_DO_QUEUE",
				"class_name": "DOQueueHandler"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"DOQueueHandler"
			]
		}
	]
}