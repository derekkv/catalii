# Puerto del servidor Express
PORT=8787

# Entorno: development | production
NODE_ENV=development

# Supabase (mismo proyecto que el front)
# URL pública del proyecto
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave anon (para validar el token del usuario y respetar RLS)
SUPABASE_ANON_KEY=
# Clave service_role (SOLO en el server, nunca se expone al navegador)
SUPABASE_SERVICE_ROLE_KEY=

# Orígenes permitidos para CORS, separados por coma
# Ej: http://localhost:3000,https://catalii.com
CORS_ORIGINS=http://localhost:3000
