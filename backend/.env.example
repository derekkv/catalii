# Puerto del servidor Express
PORT=8787

# Entorno: development | production
NODE_ENV=development

# Supabase (mismo proyecto que el front)
# URL pública del proyecto
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave anon (para validar el token del usuario y respetar RLS)
SUPABASE_ANON_KEY=
# Clave service_role (SOLO en el server, nunca se expone al navegador)
SUPABASE_SERVICE_ROLE_KEY=

# Orígenes permitidos para CORS, separados por coma
# Solo importa si algún día el NAVEGADOR llama al backend. Hoy no lo hace: el
# Worker reenvía desde el servidor y esas peticiones no llevan Origin.
# Ej: http://localhost:3000,https://catalii.com,https://www.catalii.com
CORS_ORIGINS=http://localhost:3000

# --- Analítica (MongoDB) ---------------------------------------------------
# OPCIONAL. Si se deja vacía, el backend arranca igual y la analítica queda
# desactivada: POST /api/metrics/events descarta los eventos (204) y
# GET /api/metrics/* responde 503. Los pedidos y el resto de la API no se
# enteran. Ej: mongodb+srv://usuario:clave@cluster.xxxx.mongodb.net/
MONGODB_URI=
# Base de datos dentro del cluster
MONGODB_DB=catalii
# Días que se conservan los eventos (de aquí sale el TTL del índice)
METRICS_RETENTION_DAYS=180

# Correos con acceso a las métricas globales (GET /api/metrics/summary),
# separados por coma. Vacío = nadie entra (responde 404, no 403).
ADMIN_EMAILS=
