# ─────────────────────────────────────────────────────────────
# Catalii (catalii.com) — Variables de entorno (copia a .env.local)
# NUNCA subas .env.local al repositorio.
# ─────────────────────────────────────────────────────────────

# URL pública del sitio (sin barra final). En Vercel se detecta sola.
# Producción: https://catalii.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────
# Panel: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anon_o_publicable
# SECRETA — solo servidor (webhook). NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# ── Paddle (Billing) ──────────────────────────────────────────
# Paddle > Developer tools > Authentication
NEXT_PUBLIC_PADDLE_ENV=sandbox            # sandbox | production
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...  # token de cliente (seguro en el navegador)
PADDLE_API_KEY=pdl_sdbx_apikey_...        # SECRETA — solo servidor
PADDLE_NOTIFICATION_WEBHOOK_SECRET=pdl_ntfset_...  # secreto del webhook

# IDs de precio de Paddle (pri_...) por plan — se muestran en el checkout
NEXT_PUBLIC_PADDLE_PRICE_STARTER=pri_...
NEXT_PUBLIC_PADDLE_PRICE_PRO=pri_...
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS=pri_...

# IDs de producto de Paddle (pro_...) — para mapear la suscripción al plan
PADDLE_PRODUCT_STARTER=pro_...
PADDLE_PRODUCT_PRO=pro_...
PADDLE_PRODUCT_BUSINESS=pro_...


# ── Imágenes (Cloudflare R2) ──────────────────────────────────
# Base pública de las imágenes subidas. Déjala VACÍA para servirlas desde la
# propia app (/api/media/...): funciona en `next dev` y en producción sin más.
# Apúntala al Worker de medios (media-worker/) SOLO cuando esté desplegado con
# su dominio, p. ej. https://media.catalii.com. Si apunta a un dominio que no
# sirve los objetos (o en dev, donde las imágenes viven en el R2 local), las
# fotos se suben y guardan bien pero se ven ROTAS.
# Con `pnpm media:dev` en local puedes usar: http://localhost:8788
NEXT_PUBLIC_MEDIA_URL=

# ── UI ────────────────────────────────────────────────────────
# Aviso "en desarrollo" (barra inferior descartable). Ponlo en "false" para
# ocultarlo del todo. Nunca aparece en los catálogos públicos (/c/*).
NEXT_PUBLIC_SHOW_DEV_NOTICE=true

# ─────────────────────────────────────────────────────────────
# Backend (API Express): sus variables van en backend/.env
# (copia backend/.env.example). Usa la MISMA Supabase que el front.
# ─────────────────────────────────────────────────────────────
