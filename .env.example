NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anon_o_publicable
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
NEXT_PUBLIC_PADDLE_ENV=sandbox            # sandbox | production
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...  # token de cliente (seguro en el navegador)
PADDLE_API_KEY=pdl_sdbx_apikey_...        # SECRETA — solo servidor
PADDLE_NOTIFICATION_WEBHOOK_SECRET=pdl_ntfset_...  # secreto del webhook
NEXT_PUBLIC_PADDLE_PRICE_STARTER=pri_...
NEXT_PUBLIC_PADDLE_PRICE_PRO=pri_...
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS=pri_...
PADDLE_PRODUCT_STARTER=pro_...
PADDLE_PRODUCT_PRO=pro_...
PADDLE_PRODUCT_BUSINESS=pro_...
NEXT_PUBLIC_MEDIA_URL=
NEXT_PUBLIC_SHOW_DEV_NOTICE=true

# Backend Express (backend/). Opcional: si está vacío, el panel sigue usando
# Supabase directo. Con valor, pedidos/productos/catálogos pasan por la API.
# Solo servidor (sin NEXT_PUBLIC_): ej. http://localhost:8787
BACKEND_URL=

# Métricas (visitas y clics). Viven en MongoDB detrás del mismo backend, así
# que por defecto se usa BACKEND_URL. Esta variable solo hace falta para
# apuntar las métricas al backend SIN activar el resto de la migración
# (pedidos, productos, catálogos). En producción las dos son
# https://back.catalii.com. Si ninguna tiene valor, el panel avisa de que las
# métricas no están disponibles (no muestra ceros) y los eventos se descartan.
METRICS_API_URL=

# Panel de administración del SaaS (/admin). Correos con acceso, separados por
# comas. Solo servidor (sin NEXT_PUBLIC_): es la ÚNICA barrera del panel, que
# consulta con la service_role y salta RLS.
#
#   · Vacío o sin definir  → /admin responde 404 para TODOS, incluido el dueño.
#     No hay mensaje en pantalla a propósito (un 403 confirmaría que la ruta
#     existe); el aviso sale en el log del servidor al abrirla.
#   · Se compara contra el correo verificado por Supabase Auth, sin distinguir
#     mayúsculas. Dar o quitar acceso es un cambio de entorno + redespliegue.
ADMIN_EMAILS=derek@catalii.com
