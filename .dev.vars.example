# Secretos de RUNTIME para desarrollo local con Wrangler (`pnpm cf:preview`).
# Copia a `.dev.vars` (ignorado por git). En producción usa `wrangler secret put`.
#
# NOTA: las variables NEXT_PUBLIC_* NO van aquí: se inyectan en el BUILD
# (deben existir como variables de entorno al ejecutar `pnpm cf:build`).

SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
PADDLE_API_KEY=pdl_sdbx_apikey_...
PADDLE_NOTIFICATION_WEBHOOK_SECRET=pdl_ntfset_...
PADDLE_PRODUCT_STARTER=pro_...
PADDLE_PRODUCT_PRO=pro_...
PADDLE_PRODUCT_BUSINESS=pro_...
